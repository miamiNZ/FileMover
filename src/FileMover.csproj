<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FileMover</RootNamespace>
    <AssemblyName>FileMover</AssemblyName>
    <Version>1.1.0</Version>
    <Product>FileMover</Product>
    <Description>Copy and move files between local disks and SSH/SFTP servers.</Description>
    <!-- Embed PDB into the EXE instead of a separate .pdb file -->
    <DebugType>embedded</DebugType>
    <!-- wwwroot is EmbeddedResource — no static assets pipeline needed -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Not hosting on IIS — suppress web.config generation -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FileMover.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" />
    <Content Remove="wwwroot\**" />
  </ItemGroup>
</Project>
