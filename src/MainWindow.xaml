<Window x:Class="FileMover.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Mover" Height="892" Width="960"
        MinHeight="752" MinWidth="780"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI" FontSize="13">

  <WindowChrome.WindowChrome>
    <WindowChrome ResizeBorderThickness="5" CaptionHeight="32"
                  GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- ── Charcoal palette (dark defaults) ────────────────────── -->
    <SolidColorBrush x:Key="BgBrush"          Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#252525"/>
    <SolidColorBrush x:Key="CardBrush"        Color="#111111"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#3D3D3D"/>
    <SolidColorBrush x:Key="TitleBarBrush"    Color="#1C1C1C"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SubtextBrush"     Color="#888888"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#5B9BD5"/>
    <SolidColorBrush x:Key="SuccessBrush"     Color="#5DB85D"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="#E8A838"/>
    <SolidColorBrush x:Key="ErrorBrush"       Color="#E05050"/>
    <SolidColorBrush x:Key="AltBrush"         Color="#7DBCCC"/>
    <SolidColorBrush x:Key="HeaderBrush"      Color="#303030"/>
    <SolidColorBrush x:Key="PanelBrush"       Color="#181818"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="BtnBgBrush"       Color="#2E2E2E"/>
    <SolidColorBrush x:Key="BtnHoverBrush"    Color="#3A3A3A"/>
    <SolidColorBrush x:Key="BtnPressedBrush"  Color="#474747"/>
    <SolidColorBrush x:Key="ChkCheckedBrush"  Color="#0E2340"/>

    <!-- ── GroupBox ──────────────────────────────────────────────── -->
    <Style TargetType="GroupBox">
      <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Padding"         Value="10,8"/>
      <Setter Property="Margin"          Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="5,5,0,0" Padding="12,5">
                <ContentPresenter ContentSource="Header"
                                  TextBlock.FontWeight="SemiBold"
                                  TextBlock.Foreground="{DynamicResource AccentBrush}"
                                  TextBlock.FontSize="11.5"/>
              </Border>
              <Border Grid.Row="1"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="0,0,5,5"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── RadioButton ────────────────────────────────────────────── -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground"              Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor"                  Value="Hand"/>
      <Setter Property="Margin"                  Value="0,0,14,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Background="Transparent">
              <Grid Width="17" Height="17" Margin="0,0,7,0" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.5"
                         Fill="{DynamicResource CardBrush}"/>
                <Ellipse x:Name="Dot" Width="9" Height="9"
                         Fill="{DynamicResource AccentBrush}" Opacity="0"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Opacity" Value="0.4"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked"   Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── CheckBox ───────────────────────────────────────────────── -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground"              Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor"                  Value="Hand"/>
      <Setter Property="Margin"                  Value="0,0,18,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" Margin="0,0,7,0"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                      Background="{DynamicResource CardBrush}" CornerRadius="3" VerticalAlignment="Center">
                <TextBlock x:Name="Tick" Text="&#x2713;"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box"  Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Box"  Property="Background"  Value="{DynamicResource ChkCheckedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Label ──────────────────────────────────────────────────── -->
    <Style TargetType="Label">
      <Setter Property="Foreground"              Value="{DynamicResource SubtextBrush}"/>
      <Setter Property="Padding"                 Value="0,2,6,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ── TextBox ────────────────────────────────────────────────── -->
    <Style TargetType="TextBox">
      <Setter Property="Background"              Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground"              Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush"             Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness"         Value="1"/>
      <Setter Property="Padding"                 Value="7,0"/>
      <Setter Property="Height"                  Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush"              Value="{DynamicResource AccentBrush}"/>
      <Setter Property="SelectionBrush"          Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ── PasswordBox ────────────────────────────────────────────── -->
    <Style TargetType="PasswordBox">
      <Setter Property="Background"              Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground"              Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush"             Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness"         Value="1"/>
      <Setter Property="Padding"                 Value="7,0"/>
      <Setter Property="Height"                  Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush"              Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsFocused" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ── Button base ────────────────────────────────────────────── -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background"      Value="{DynamicResource BtnBgBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="12,0"/>
      <Setter Property="Height"          Value="30"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnPressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>

    <!-- Steel-blue Start button -->
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background"  Value="#2E6DA4"/>
      <Setter Property="BorderBrush" Value="#2E6DA4"/>
      <Setter Property="Foreground"  Value="#FFFFFF"/>
      <Setter Property="FontWeight"  Value="SemiBold"/>
      <Setter Property="Padding"     Value="22,0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background"  Value="#3A82C4"/>
          <Setter Property="BorderBrush" Value="#3A82C4"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background"  Value="#225580"/>
          <Setter Property="BorderBrush" Value="#225580"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Red Cancel button -->
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background"  Value="#5A1818"/>
      <Setter Property="BorderBrush" Value="#7A2020"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#7A2020"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ── Title-bar buttons ─────────────────────────────────────── -->
    <Style x:Key="TitleBarBtn" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="{DynamicResource SubtextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize"        Value="14"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Height"          Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource BtnPressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#9E1F12"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ── ProgressBar ────────────────────────────────────────────── -->
    <Style TargetType="ProgressBar">
      <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" ClipToBounds="True">
              <Grid>
                <Rectangle x:Name="PART_Track"/>
                <Border x:Name="PART_Indicator"
                        Background="{TemplateBinding Foreground}"
                        CornerRadius="4" HorizontalAlignment="Left"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── ListBox ────────────────────────────────────────────────── -->
    <Style TargetType="ListBox">
      <Setter Property="Background"      Value="{DynamicResource CardBrush}"/>
      <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer Focusable="False" Padding="4,4">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding"    Value="4,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Slider ─────────────────────────────────────────────────── -->
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ── Log entry template — binds Brush (WPF Brush) ─────────── -->
    <DataTemplate x:Key="LogTemplate">
      <TextBlock Text="{Binding FormattedMessage}"
                 Foreground="{Binding Brush}"
                 FontFamily="Consolas" FontSize="11.5"
                 TextWrapping="NoWrap"/>
    </DataTemplate>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CUSTOM TITLE BAR                                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="0"
          Background="{DynamicResource TitleBarBrush}"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="File Mover"
                 Foreground="{DynamicResource SubtextBrush}"
                 FontSize="12" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="14,0"
                 WindowChrome.IsHitTestVisibleInChrome="False"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="btnMinimize"
                Content="&#x2500;" Width="46"
                Style="{StaticResource TitleBarBtn}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="BtnMinimize_Click" ToolTip="Minimize"/>
        <Button x:Name="btnMaximize"
                Content="&#x25A1;" Width="46"
                Style="{StaticResource TitleBarBtn}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="BtnMaximize_Click" ToolTip="Maximize"/>
        <Button x:Name="btnClose"
                Content="&#x2715;" Width="46"
                Style="{StaticResource TitleBarCloseBtn}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="BtnClose_Click" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- MAIN CONTENT                                               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="1" Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OPTIONS  (row 0)                                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <GroupBox Header="OPTIONS" Grid.Row="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Label Content="Operation:" Padding="0,0,10,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbOpCopy" Content="Copy" GroupName="OpMode" IsChecked="True"/>
            <RadioButton x:Name="rbOpMove" Content="Move" GroupName="OpMode"
                         ToolTip="Files are deleted from the source after a successful copy"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Label Content="Mode:" Padding="0,0,10,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="rbModeFile"   Content="Single file"     GroupName="CopyMode"
                         Checked="SrcMode_Changed"/>
            <RadioButton x:Name="rbModeMulti"  Content="Multiple files"  GroupName="CopyMode"
                         Checked="SrcMode_Changed"/>
            <RadioButton x:Name="rbModeFolder" Content="Folder contents" GroupName="CopyMode"
                         IsChecked="True" Checked="SrcMode_Changed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <CheckBox x:Name="chkVerify"    Content="Verify (MD5)"       IsChecked="True"/>
            <CheckBox x:Name="chkOverwrite" Content="Overwrite existing" IsChecked="True"/>
            <CheckBox x:Name="chkRecursive" Content="Recursive"          IsChecked="True"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="chkSetPerms" Content="Set permissions (SSH):"
                      IsChecked="True" Margin="0,0,6,0"
                      ToolTip="Runs chmod on each file after copying to an SSH destination"/>
            <TextBox x:Name="txtPermMode" Text="644" Width="52" Height="26"
                     ToolTip="Octal file mode, e.g. 644. Directories always get 755."/>
            <TextBlock Text=" (octal)" Foreground="{DynamicResource SubtextBrush}"
                       VerticalAlignment="Center" FontSize="11" Margin="5,0,0,0"/>
          </StackPanel>
        </StackPanel>

        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" Margin="12,2"/>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Foreground="{DynamicResource SubtextBrush}" FontSize="11"
                     Margin="0,0,0,4">Concurrent transfers</TextBlock>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="sldThreads" Grid.Column="0"
                    Minimum="1" Maximum="16" Value="4"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    ValueChanged="SldThreads_Changed" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtThreadCount" Grid.Column="1"
                       Text="4" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center" TextAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SOURCE  (row 1)                                            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <GroupBox Header="SOURCE" Grid.Row="1">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Label Content="Type:" Padding="0,0,10,0" VerticalAlignment="Center"/>
          <RadioButton x:Name="rbSrcLocal" Content="Local" GroupName="SrcType"
                       IsChecked="True" Checked="SrcType_Changed"/>
          <RadioButton x:Name="rbSrcSSH"   Content="SSH"   GroupName="SrcType"
                       Checked="SrcType_Changed"/>
        </StackPanel>

        <Grid x:Name="pnlSrcSinglePath">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="82"/>
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0" Content="Path:" HorizontalAlignment="Right"/>
          <TextBox x:Name="txtSrcPath" Grid.Column="1"/>
          <Button x:Name="btnSrcBrowse" Grid.Column="3"
                  Content="Browse&#x2026;" Click="BtnSrcBrowse_Click"/>
        </Grid>

        <!-- Multiple-files list (visible when Mode = Multiple files) -->
        <Border x:Name="pnlSrcMultiFiles" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,4,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="90"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="lstSrcFiles" Grid.Row="0"
                     SelectionMode="Extended"
                     FontFamily="Consolas" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding}"
                             Foreground="{DynamicResource TextBrush}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,5,0,0">
              <Button Content="Add&#x2026;" Width="72" Margin="0,0,6,0"
                      Click="BtnSrcAddFiles_Click"
                      ToolTip="Local: multi-select files. SSH: browse and add one at a time."/>
              <Button Content="Remove" Width="72" Margin="0,0,6,0"
                      Click="BtnSrcRemoveFiles_Click"/>
              <Button Content="Clear all" Width="72"
                      Click="BtnSrcClearFiles_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="pnlSrcSSH" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,8,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0" Content="Host:"/>
              <TextBox x:Name="txtSrcHost" Grid.Column="1" TextChanged="SrcCred_Changed"/>
              <Label Grid.Column="3" Content="Port:" HorizontalAlignment="Right"/>
              <TextBox x:Name="txtSrcPort" Grid.Column="4" Text="22" TextChanged="SrcCred_Changed"/>
              <Label Grid.Column="6" Content="Username:"/>
              <TextBox x:Name="txtSrcUser" Grid.Column="7" TextChanged="SrcCred_Changed"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="28"/>
              </Grid.ColumnDefinitions>
              <RadioButton x:Name="rbSrcPwd" Content="Password:"
                           GroupName="SrcAuth" IsChecked="True"
                           Grid.Column="0" Checked="SrcAuth_Changed"/>
              <PasswordBox x:Name="pbSrcPwd" Grid.Column="1" PasswordChanged="SrcPwd_Changed"/>
              <RadioButton x:Name="rbSrcKey" Content="Key file:"
                           GroupName="SrcAuth" Grid.Column="3"
                           Checked="SrcAuth_Changed"/>
              <TextBox x:Name="txtSrcKey" Grid.Column="4" IsEnabled="False"
                       ToolTip="Path to private key (.pem / .ppk)" TextChanged="SrcCred_Changed"/>
              <Button x:Name="btnSrcKey" Grid.Column="6" Content="&#x2026;"
                      IsEnabled="False" Click="BtnSrcKey_Click"/>
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="btnSrcConnect" Content="Connect"
                      Click="BtnSrcConnect_Click"/>
              <TextBlock x:Name="txtSrcConnectStatus" Grid.Column="1"
                         Margin="10,0,0,0" VerticalAlignment="Center"
                         FontSize="11.5" Foreground="{DynamicResource SubtextBrush}"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </GroupBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- DESTINATION  (row 2)                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <GroupBox Header="DESTINATION" Grid.Row="2">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Label Content="Type:" Padding="0,0,10,0" VerticalAlignment="Center"/>
          <RadioButton x:Name="rbDstLocal" Content="Local" GroupName="DstType"
                       IsChecked="True" Checked="DstType_Changed"/>
          <RadioButton x:Name="rbDstSSH"   Content="SSH"   GroupName="DstType"
                       Checked="DstType_Changed"/>
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="82"/>
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0" Content="Path:" HorizontalAlignment="Right"/>
          <TextBox x:Name="txtDstPath" Grid.Column="1"/>
          <Button x:Name="btnDstBrowse" Grid.Column="3"
                  Content="Browse&#x2026;" Click="BtnDstBrowse_Click"/>
        </Grid>

        <Grid Margin="0,3,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Label Grid.Column="0" Content="Free:" HorizontalAlignment="Right"/>
          <TextBlock x:Name="txtDstFreeSpace" Grid.Column="1"
                     Text="—" VerticalAlignment="Center"
                     Foreground="{DynamicResource SubtextBrush}" FontSize="11.5"/>
        </Grid>

        <Border x:Name="pnlDstSSH" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,8,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="74"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0" Content="Host:"/>
              <TextBox x:Name="txtDstHost" Grid.Column="1" TextChanged="DstCred_Changed"/>
              <Label Grid.Column="3" Content="Port:" HorizontalAlignment="Right"/>
              <TextBox x:Name="txtDstPort" Grid.Column="4" Text="22" TextChanged="DstCred_Changed"/>
              <Label Grid.Column="6" Content="Username:"/>
              <TextBox x:Name="txtDstUser" Grid.Column="7" TextChanged="DstCred_Changed"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="28"/>
              </Grid.ColumnDefinitions>
              <RadioButton x:Name="rbDstPwd" Content="Password:"
                           GroupName="DstAuth" IsChecked="True"
                           Grid.Column="0" Checked="DstAuth_Changed"/>
              <PasswordBox x:Name="pbDstPwd" Grid.Column="1" PasswordChanged="DstPwd_Changed"/>
              <RadioButton x:Name="rbDstKey" Content="Key file:"
                           GroupName="DstAuth" Grid.Column="3"
                           Checked="DstAuth_Changed"/>
              <TextBox x:Name="txtDstKey" Grid.Column="4" IsEnabled="False"
                       ToolTip="Path to private key (.pem / .ppk)" TextChanged="DstCred_Changed"/>
              <Button x:Name="btnDstKey" Grid.Column="6" Content="&#x2026;"
                      IsEnabled="False" Click="BtnDstKey_Click"/>
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="btnDstConnect" Content="Connect"
                      Click="BtnDstConnect_Click"/>
              <TextBlock x:Name="txtDstConnectStatus" Grid.Column="1"
                         Margin="10,0,0,0" VerticalAlignment="Center"
                         FontSize="11.5" Foreground="{DynamicResource SubtextBrush}"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </GroupBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PROGRESS  (row 3)                                          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <GroupBox Header="PROGRESS" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="52"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Overall:" Foreground="{DynamicResource SubtextBrush}"
                     VerticalAlignment="Center" FontSize="11.5"/>
          <ProgressBar x:Name="pbOverall" Grid.Column="1" Margin="0,0,8,0" Height="18"/>
          <TextBlock x:Name="txtOverallPct" Grid.Column="2"
                     Text="0%" Foreground="{DynamicResource AccentBrush}"
                     FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="62"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="52"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Current:" Foreground="{DynamicResource SubtextBrush}"
                     VerticalAlignment="Center" FontSize="11.5"/>
          <ProgressBar x:Name="pbCurrent" Grid.Column="1" Margin="0,0,8,0" Height="18"
                       Foreground="{DynamicResource AltBrush}"/>
          <TextBlock x:Name="txtCurrentPct" Grid.Column="2"
                     Text="0%" Foreground="{DynamicResource AltBrush}"
                     FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>

        <TextBlock x:Name="txtCurrentFile" Grid.Row="2"
                   Text="&#x2014;" Foreground="{DynamicResource SubtextBrush}"
                   FontFamily="Consolas" FontSize="11"
                   Margin="62,0,0,8" TextTrimming="CharacterEllipsis"/>

        <UniformGrid Grid.Row="3" Columns="5">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="SPEED" Foreground="{DynamicResource SubtextBrush}" FontSize="10"/>
            <TextBlock x:Name="txtSpeed" Text="&#x2014;"
                       Foreground="{DynamicResource SuccessBrush}"
                       FontWeight="Bold" FontSize="15"/>
          </StackPanel>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="ETA" Foreground="{DynamicResource SubtextBrush}" FontSize="10"/>
            <TextBlock x:Name="txtETA" Text="&#x2014;"
                       Foreground="{DynamicResource WarningBrush}"
                       FontWeight="Bold" FontSize="15"/>
          </StackPanel>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="TIME" Foreground="{DynamicResource SubtextBrush}" FontSize="10"/>
            <TextBlock x:Name="txtTime" Text="&#x2014;"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="Bold" FontSize="15"/>
          </StackPanel>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="FILES" Foreground="{DynamicResource SubtextBrush}" FontSize="10"/>
            <TextBlock x:Name="txtFiles" Text="&#x2014;"
                       Foreground="{DynamicResource TextBrush}" FontSize="13"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="DATA" Foreground="{DynamicResource SubtextBrush}" FontSize="10"/>
            <TextBlock x:Name="txtBytes" Text="&#x2014;"
                       Foreground="{DynamicResource TextBrush}" FontSize="13"/>
          </StackPanel>
        </UniformGrid>
      </Grid>
    </GroupBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- LOG  (row 4)                                               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <GroupBox Header="LOG" Grid.Row="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="lstLog" Grid.Row="0"
                 ItemTemplate="{StaticResource LogTemplate}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <Button Grid.Row="1" Content="Clear log" HorizontalAlignment="Right"
                Margin="0,5,0,0" Padding="10,3" Height="24" FontSize="11"
                Click="BtnClearLog_Click"/>
      </Grid>
    </GroupBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ACTION BAR  (row 5)                                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="5" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="txtStatus" Grid.Column="0"
                 Text="Ready" Foreground="{DynamicResource SubtextBrush}"
                 VerticalAlignment="Center" FontSize="12"/>
      <Button x:Name="btnTheme" Grid.Column="1"
              Content="Light Mode" Height="36" Padding="14,0"
              Click="BtnTheme_Click"/>
      <Button x:Name="btnStart" Grid.Column="3"
              Content="&#x25B6;  Start Copy" Style="{StaticResource AccentBtn}"
              Height="36" Click="BtnStart_Click"/>
      <Button x:Name="btnCancel" Grid.Column="5"
              Content="&#x2715;  Cancel" Style="{StaticResource DangerBtn}"
              Height="36" IsEnabled="False" Click="BtnCancel_Click"/>
    </Grid>

    </Grid>
  </Grid>
</Window>
