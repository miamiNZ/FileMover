<Window x:Class="FileMover.SftpBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Remote Folder (SSH)"
        Height="500" Width="540"
        MinHeight="380" MinWidth="420"
        Background="#1A1A1A"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ResizeMode="CanResize">

  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush"    Color="#111111"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#252525"/>
    <SolidColorBrush x:Key="BorderBrush"  Color="#3D3D3D"/>
    <SolidColorBrush x:Key="TextBrush"    Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SubtextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="AccentBrush"  Color="#5B9BD5"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5DB85D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E8A838"/>
    <SolidColorBrush x:Key="ErrorBrush"   Color="#E05050"/>

    <Style TargetType="TextBox">
      <Setter Property="Background"      Value="{StaticResource CardBrush}"/>
      <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="7,0"/>
      <Setter Property="Height"          Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush"      Value="{StaticResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsFocused" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
      <Setter Property="Background"      Value="#2E2E2E"/>
      <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="12,0"/>
      <Setter Property="Height"          Value="30"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3A3A3A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#474747"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>

    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background"  Value="#2E6DA4"/>
      <Setter Property="BorderBrush" Value="#2E6DA4"/>
      <Setter Property="Foreground"  Value="#FFFFFF"/>
      <Setter Property="FontWeight"  Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background"  Value="#3A82C4"/>
          <Setter Property="BorderBrush" Value="#3A82C4"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background"  Value="#225580"/>
          <Setter Property="BorderBrush" Value="#225580"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="FolderTemplate">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="📁" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12"
                   Foreground="#E8E8E8" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <Style TargetType="ListBox">
      <Setter Property="Background"      Value="{StaticResource CardBrush}"/>
      <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ScrollViewer Focusable="False" Padding="4">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding"    Value="6,4"/>
      <Setter Property="Cursor"     Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A3A5A"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected"   Value="True"/>
                  <Condition Property="IsMouseOver"  Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#224870"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Status bar -->
    <Border Grid.Row="0" Background="#252525"
            BorderBrush="#3D3D3D" BorderThickness="1"
            CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="txtStatusIcon" Text="⏳" Margin="0,0,7,0" FontSize="13"/>
        <TextBlock x:Name="txtBrowserStatus" Text="Connecting…"
                   Foreground="{StaticResource WarningBrush}"
                   FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Navigation bar -->
    <Grid Grid.Row="1" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="34"/>
        <ColumnDefinition Width="34"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="46"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="btnBack" Grid.Column="0" Content="←" ToolTip="Go back"
              Margin="0,0,4,0" IsEnabled="False" Click="BtnBack_Click" FontSize="14"/>
      <Button x:Name="btnUp"   Grid.Column="1" Content="↑" ToolTip="Go up one level"
              IsEnabled="False" Click="BtnUp_Click" FontSize="14"/>
      <TextBox x:Name="txtNavPath" Grid.Column="3"
               ToolTip="Type a path and press Enter or Go"
               KeyDown="TxtNavPath_KeyDown"/>
      <Button x:Name="btnGo" Grid.Column="5" Content="Go" Click="BtnGo_Click"/>
    </Grid>

    <!-- Folder list with loading overlay -->
    <Grid Grid.Row="2">
      <ListBox x:Name="lstFolders"
               ItemTemplate="{StaticResource FolderTemplate}"
               MouseDoubleClick="LstFolders_DoubleClick"
               SelectionChanged="LstFolders_SelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      <Border x:Name="pnlLoading" Background="#CC111111"
              CornerRadius="4" Visibility="Collapsed">
        <TextBlock Text="Loading…" Foreground="{StaticResource WarningBrush}"
                   FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Grid>

    <!-- Selected path display -->
    <Border Grid.Row="3" Background="#252525"
            BorderBrush="#3D3D3D" BorderThickness="1"
            CornerRadius="4" Padding="10,6" Margin="0,6,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Selected: " Foreground="{StaticResource SubtextBrush}"
                   FontSize="11.5" VerticalAlignment="Center"/>
        <TextBlock x:Name="txtSelectedPath" Grid.Column="1"
                   Text="—" Foreground="{StaticResource AccentBrush}"
                   FontFamily="Consolas" FontSize="11.5"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Buttons -->
    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="txtItemCount" Grid.Column="0"
                 Foreground="{StaticResource SubtextBrush}"
                 FontSize="11.5" VerticalAlignment="Center"/>
      <Button x:Name="btnSelect" Grid.Column="1"
              Content="Select This Folder" Style="{StaticResource AccentBtn}"
              Height="34" IsEnabled="False" Click="BtnSelect_Click"
              ToolTip="Use this folder as the destination path"/>
      <Button Grid.Column="3" Content="Cancel" Height="34" Click="BtnCancel_Click"/>
    </Grid>
  </Grid>
</Window>
