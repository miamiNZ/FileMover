<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileMover</RootNamespace>
    <AssemblyName>FileMover</AssemblyName>
    <!-- Embed PDB into the EXE instead of a separate .pdb file -->
    <DebugType>embedded</DebugType>
    <!-- wwwroot is EmbeddedResource — no static assets pipeline needed -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- Not hosting on IIS — suppress web.config generation -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" />
    <Content Remove="wwwroot\**" />
  </ItemGroup>
</Project>
